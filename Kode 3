void generateAcak() {
    int n, minVal, maxVal;
    cout << "Masukkan jumlah data: ";
    cin >> n;
    cout << "Masukkan nilai minimal acak: ";
    cin >> minVal;
    cout << "Masukkan nilai maksimal acak: ";
    cin >> maxVal;

    dataUtama.clear();
    for (int i = 0; i < n; i++) {
        int acak = minVal + (ran() % (maxVal - minVal + 1));
        dataUtama.push_back(acak);
    }
    cout << "=> " << n << "data acak berhasil digenerate.\n";
}
