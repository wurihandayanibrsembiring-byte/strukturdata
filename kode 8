int jumpSearchCore(const vector<int>& arr, int target, int& steps) {
    int n = arr.size();
    int step = sqrt(n);
    int prev = 0; steps = 0;
    
    while (arr[min(step, n) - 1] < target) {
        steps++;
        prev = step;
        step += sqrt(n);
        if (prev >= n) return -1;
    }
    while (arr[prev] < target) {
        steps++; prev++;
        if (prev == min(step, n)) return -1;
    }
    steps++;
    if (arr[prev] == target) return prev;
    return -1;
}

